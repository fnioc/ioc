{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "src",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // The @fnioc/transformer ts-patch plugin. Active under `tspc` (the build);
    // plain `tsc` (the lint task) ignores it and type-checks the authored form.
    // The plugin's `declare module "@fnioc/di"` augmentation (the type-driven
    // authoring forms `add<I>(C)`, `.as<"x">()`) is pulled into the program by
    // the side-effect reference in src/fnioc-transformer.d.ts — not a `types`
    // array, which would disable the ambient @types (console) auto-inclusion.
    "plugins": [{ "transform": "@fnioc/transformer", "import": "transform" }]
  },
  "include": ["src/**/*"]
}
